{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Albums",
    "type": "array",
    "items": {
      "$ref": "#/$defs/Album"
    },
    "minItems": 1,
    "uniqueItems": true,
    "$defs": {
      "Album": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "description": "Name of the album",
            "type": "string"
          },
          "query": {
            "$ref": "#/$defs/Query"
          }
        },
        "required": [
          "name",
          "query"
        ]
      },
      "Query": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": false,
        "allOf": [
          {
            "not": {"required": ["people", "any_people"]}
          },
          {
            "not": {"required": ["smart_query", "people_strict_mode"]}
          }
        ],
        "properties": {
          "country": {
            "anyOf": [
              {"type": "string"},
              {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
            ]
          },
          "state": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "favorite": {
            "type": "boolean"
          },
          "people": {
            "anyOf": [
              {"type": "string"},
              {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
            ]
          },
          "people_strict_mode": {
            "type": "boolean"
          },
          "timespan": {
            "anyOf": [
              {"$ref": "#/$defs/Timespan"},
              {"type": "array", "items": {"$ref": "#/$defs/Timespan"}, "uniqueItems": true}
            ]
          },
          "tags": {
            "anyOf": [
              {"type": "string"},
              {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
            ]
          },
          "any_people": {
            "description": "Assets must contain at least one of these people. Cannot be used with 'people' (which implies AND logic for all its members) in the same query block.",
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "smart_query": {
            "description": "Natural language query for Immich's smart (CLIP) search. Combined with any other filters in this query block. Cannot be used with 'people_strict_mode', since smart search does not return face data.",
            "type": "string",
            "minLength": 1
          },
          "smart_query_limit": {
            "description": "Maximum number of results returned by 'smart_query'. Smart search has no pagination, so this is a hard cap (Immich's own maximum is 1000).",
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          }
        }
      },
      "Timespan": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "start": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "end": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          }
        },
        "required": [
          "start",
          "end"
        ]
      }
    }
  }
